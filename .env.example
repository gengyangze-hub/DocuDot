# ============================================================
#  DocuDot 仓储助手 · 配置示例
#  用法：cp .env.example .env  然后按需填写
#  （或者直接跑 bash scripts/deploy.sh，它会交互式问好再写这个文件）
# ============================================================

# ---------------- 服务 ----------------
# 默认只监听本机：QQ 机器人是**主动外连**，不需要暴露入站端口。
# 要远程调接口就改成 0.0.0.0，并去云厂商安全组放行（更稳的是 Nginx 反代 + HTTPS）。
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info
# SQLite 数据库文件（相对路径基于项目根目录）
DATABASE_PATH=./data/inventory.db
# 上传的原始文件 / 导入缓存目录
DATA_DIR=./data

# 首次启动时若 api_keys 表为空，用这个值创建一个 admin key。
# **留空 = 首次启动自动生成一个强随机 Key，并在日志里打印一次**（推荐，安全默认值）。
# 也可以自己填：至少 16 位随机字符，例如 openssl rand -base64 24
BOOTSTRAP_API_KEY=

# ---------------- 模糊匹配 ----------------
# difflib/子串相似度阈值，低于该值不作为候选返回（0~1）
FUZZY_THRESHOLD=0.55
# 单次搜索最多返回多少条候选
FUZZY_MAX_CANDIDATES=10

# ---------------- 大模型（可选） ----------------
# 用于 /api/v1/analysis/ai 和「AI 规范化导入」
LLM_ENABLED=false
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60

# ---------------- QQ 官方机器人（可选） ----------------
# 走 QQ 机器人开放平台的 WebSocket 网关，无需公网回调地址
QQ_BOT_ENABLED=false
QQ_APP_ID=
QQ_APP_SECRET=
# 老式凭证（部分机器人只有 token），填了则优先用 secret
QQ_BOT_TOKEN=
# true = 使用沙箱环境
QQ_SANDBOX=false
# 事件订阅位（十进制或 1<<n 表达式均可），默认 PUBLIC_GUILD_MESSAGES + GROUP_AND_C2C_EVENT
QQ_INTENTS=1107296256
# 白名单：留空表示不限制。多个用逗号分隔（QQ 机器人事件里的 openid / member_openid）
QQ_ALLOWED_USERS=
QQ_ALLOWED_GROUPS=
# 机器人在群里被 @ 时的触发前缀；留空表示直接解析整条消息
QQ_COMMAND_PREFIX=
# 入库后追问缺失的规格/别名（用户回「跳过」即不再追问该字段）
QQ_ASK_ON_STOCK_IN=true
# 追问策略：auto=规则优先、判不了才问 AI，觉得不值得问就直接入库（推荐）
#           always=缺什么就问什么；never=从不追问
QQ_DETAIL_PROMPTS=auto
# 命令解析模式：auto=规则优先、规则解析不出来时用 AI 兜底（推荐）
#               rules=只用关键词规则，完全不调大模型
#               ai=入库/出库一律交给大模型分析（最懂人话，但每条消息都会调用 LLM）
QQ_PARSE_MODE=auto
# AI 解析结果的可信阈值，低于它就不自动执行
QQ_AI_CONFIDENCE=0.5
# QQ 里直接发文件时的大小上限（MB）
QQ_MAX_FILE_MB=20
# 导入时让 AI 通读整批自动归类（没有的分类自动新建）
AI_CLASSIFY_ON_IMPORT=true
# 导入时让 AI 规范命名（原名会保留为别名）；与归类合并成同一次 LLM 调用
AI_NORMALIZE_ON_IMPORT=true
# 规则认不出用户意图时，让 AI 做模糊指令匹配（如「清除全部」→ 整批出库）
QQ_AI_INTENT=true
